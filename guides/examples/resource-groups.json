{
  "rootGroups": [
    {
      "name": "global",
      "softMemoryLimit": "90%",
      "hardConcurrencyLimit": 100,
      "maxQueued": 2000,
      "schedulingPolicy": "weighted",
      "jmxExport": true,
      "subGroups": [
        {
          "name": "interactive",
          "softMemoryLimit": "50%",
          "hardConcurrencyLimit": 40,
          "maxQueued": 400,
          "schedulingWeight": 4,
          "jmxExport": true,
          "subGroups": [
            {
              "name": "${USER}",
              "softMemoryLimit": "20%",
              "hardConcurrencyLimit": 5,
              "maxQueued": 20
            }
          ]
        },
        {
          "name": "scheduled",
          "softMemoryLimit": "60%",
          "hardConcurrencyLimit": 30,
          "maxQueued": 1000,
          "schedulingWeight": 2,
          "jmxExport": true
        },
        {
          "name": "automation",
          "softMemoryLimit": "30%",
          "hardConcurrencyLimit": 30,
          "maxQueued": 500,
          "schedulingWeight": 2,
          "jmxExport": true,
          "subGroups": [
            {
              "name": "${SOURCE}",
              "softMemoryLimit": "15%",
              "hardConcurrencyLimit": 10,
              "maxQueued": 100
            }
          ]
        }
      ]
    },
    {
      "name": "admin",
      "softMemoryLimit": "100%",
      "hardConcurrencyLimit": 20,
      "maxQueued": 50
    }
  ],
  "selectors": [
    {
      "userGroup": "admins",
      "group": "admin"
    },
    {
      "clientTags": [
        "scheduled"
      ],
      "group": "global.scheduled"
    },
    {
      "source": "(?i).*(airflow|scheduler|cron).*",
      "group": "global.scheduled"
    },
    {
      "clientTags": [
        "agent"
      ],
      "group": "global.automation.${SOURCE}"
    },
    {
      "source": "(?i).*(agent|service).*",
      "group": "global.automation.${SOURCE}"
    },
    {
      "group": "global.interactive.${USER}"
    }
  ],
  "cpuQuotaPeriod": "1h"
}
